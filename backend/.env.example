/**
 * Runtime configuration. Copy to `.env` and fill in what you have.
 * Nothing in this file is required for the gateway to boot; features that
 * are not configured answer with a clear "not configured" error instead.
 */

# --- service ---------------------------------------------------------------
CLAUDEN_HOST=127.0.0.1
CLAUDEN_PORT=8788
CLAUDEN_PUBLIC_BASE=https://clauden.best
CLAUDEN_DATA_DIR=data
CLAUDEN_SERVICE_NAME=clauden-gateway
CLAUDEN_LOG_REQUESTS=0

# --- inference pool --------------------------------------------------------
# The gateway forwards chat requests here (OpenAI chat-completions protocol).
# Hosted deployments receive these values from the operator; a self-hosted
# instance points them at any compatible endpoint.
CLAUDEN_UPSTREAM_BASE=
CLAUDEN_UPSTREAM_KEY=
CLAUDEN_UPSTREAM_MODEL=clauden-chat
CLAUDEN_UPSTREAM_MAX_TOKENS=64000
CLAUDEN_UPSTREAM_TIMEOUT_MS=600000

# --- subscription supplier ------------------------------------------------
# Accounts for paid plans are issued by an external supplier. Its endpoint is
# not published: the contract forbids it. See docs/ACCOUNTS.md.
CLAUDEN_ACCOUNTS_RELAY=
CLAUDEN_ACCOUNTS_SECRET=
CLAUDEN_ACCOUNTS_TIMEOUT_MS=30000

# --- auth ------------------------------------------------------------------
CLAUDEN_GOOGLE_CLIENT_IDS=
CLAUDEN_BRIDGE_SECRET=
CLAUDEN_TOKEN_TTL_MS=2592000000
CLAUDEN_DEV_CODES=0

# --- mail ------------------------------------------------------------------
# resend | mailjet
CLAUDEN_MAIL_PROVIDER=
CLAUDEN_MAIL_API_KEY=
CLAUDEN_MAIL_FROM=Clauden <no-reply@clauden.best>

# --- billing ---------------------------------------------------------------
CLAUDEN_CURRENCY=USD
CLAUDEN_USD_RUB_RATE=100

CLAUDEN_PLATEGA_BASE=https://app.platega.io
CLAUDEN_PLATEGA_MERCHANT=
CLAUDEN_PLATEGA_SECRET=
CLAUDEN_PLATEGA_SUBSCRIPTIONS=1

CLAUDEN_LAVA_BASE=https://gate.lava.top
CLAUDEN_LAVA_API_KEY=
CLAUDEN_LAVA_OFFER_ID=

CLAUDEN_XROCKET_BASE=https://pay.xrocket.tg
CLAUDEN_XROCKET_TOKEN=

# --- Anthropic key pool ----------------------------------------------------
# Original Anthropic API keys used when a subscription seat is unavailable or
# banned. Keys never live in the repository: they are imported into
# data/pool/anthropic.json, encrypted with this secret (AES-256-GCM).
CLAUDEN_POOL_SECRET=
CLAUDEN_POOL_BASE=https://api.anthropic.com
CLAUDEN_POOL_MODEL=claude-sonnet-4-5
CLAUDEN_POOL_MAX_TOKENS=32000
CLAUDEN_POOL_TIMEOUT_MS=600000

# --- limits ----------------------------------------------------------------
CLAUDEN_MAX_CONCURRENT=8
CLAUDEN_MAX_BODY_BYTES=33554432
CLAUDEN_TURN_TIMEOUT_MS=900000

# --- code sessions ---------------------------------------------------------
# Off by default: Code files live under CLAUDEN_DATA_DIR/workspace.
CLAUDEN_CODE_EXEC=0

# --- admin -----------------------------------------------------------------
# Sending x-admin-key grants plans manually. Empty = endpoint disabled.
CLAUDEN_ADMIN_KEY=
